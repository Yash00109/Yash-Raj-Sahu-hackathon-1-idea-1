# Browser configuration (Vercel project settings, or .env.development.local for `npm run dev`).
# Only PUBLIC values belong here: they are compiled into the JavaScript bundle.
# Never put a service-role / sb_secret_ key in a VITE_ variable; the app refuses to use one.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Without both values the site still works: the reservation form prepares a WhatsApp/phone
# request instead of sending it, and /staff explains that it is not configured.
#
# Edge Function secrets are separate: see supabase/functions/.env.example.
