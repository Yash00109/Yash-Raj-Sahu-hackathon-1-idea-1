# Edge Function secrets. Locally, copy to supabase/functions/.env (git-ignored).
# In the hosted project, set them with `supabase secrets set` (requires authorization).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform; never set them here.

# Comma-separated exact origins allowed to call create-reservation (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:4173

# Long random string used to hash client IPs for rate limiting. Generate a new one per environment.
RATE_LIMIT_SALT=
